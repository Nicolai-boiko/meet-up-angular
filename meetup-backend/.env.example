# Database
DB_NAME=meetup_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/meetup_db?schema=public"

# JWT
JWT_SECRET=your_jwt_secret_key

# Server
PORT=3000

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="MeetUp" <your_email@gmail.com>

# CORS
ALLOWED_ORIGINS=http://localhost:5173
